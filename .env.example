# Copia este archivo como .env y coloca tu propia clave de Google AI Studio.
# NUNCA subas el archivo .env real al repositorio.
GEMINI_API_KEY=tu_clave_de_gemini_aqui

# Opcional: modelo principal (si no se define se usa gemini-2.5-flash con fallback automático)
GEMINI_MODEL=gemini-3.5-flash-lite

# Persistencia en nube con Supabase (tabla `usuarios` vía HTTPS REST)
# Si la clave usa el prefijo `sb_secret_`, NO se envía header Authorization: Bearer.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=sb_secret_tu_clave_aqui

# Clave secreta para firmar cookies de sesión Flask
SECRET_KEY=cambia-esta-clave-secreta-en-produccion
